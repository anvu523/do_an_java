<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="monthly_revenue" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="REPORT_MONTH" class="java.lang.String"/>
    <parameter name="TOTAL_REVENUE" class="java.lang.String"/>
    <field name="saleDateText" class="java.lang.String"/>
    <field name="orderCount" class="java.lang.Integer"/>
    <field name="revenueText" class="java.lang.String"/>
    <title>
        <band height="95">
            <line>
                <reportElement x="0" y="85" width="555" height="1" forecolor="#0F172A"/>
            </line>
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="20" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="555" height="18" forecolor="#475569"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Tháng: " + $P{REPORT_MONTH}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="55" width="555" height="18" forecolor="#64748B"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isItalic="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Thời gian tạo: " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="24" backcolor="#1E293B" forecolor="#1E293B"/>
            </rectangle>
            <staticText>
                <reportElement x="10" y="3" width="170" height="18" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Ngày]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="3" width="120" height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Số hóa đơn]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="3" width="245" height="18" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Doanh thu]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="22">
            <line>
                <reportElement x="0" y="21" width="555" height="1" forecolor="#E2E8F0"/>
            </line>
            <textField>
                <reportElement x="10" y="2" width="170" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{saleDateText}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="2" width="120" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{orderCount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="2" width="245" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{revenueText}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <summary>
        <band height="40">
            <line>
                <reportElement x="0" y="5" width="555" height="1" forecolor="#0F172A"/>
            </line>
            <staticText>
                <reportElement x="10" y="10" width="170" height="20" forecolor="#0F172A"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <text><![CDATA[Tổng cộng:]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="10" width="245" height="20" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="12" isBold="true" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_REVENUE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
